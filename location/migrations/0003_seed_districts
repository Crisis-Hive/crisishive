def seed_districts(apps, schema_editor):
    District = apps.get_model("location", "District")
    if District.objects.exists():
        return  # Already seeded, skip
    District.objects.bulk_create([
        District(name=name, division=division)
        for name, division in DISTRICTS
    ])


def unseed_districts(apps, schema_editor):
    District = apps.get_model("location", "District")
    District.objects.all().delete()


